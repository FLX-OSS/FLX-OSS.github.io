---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
const guides = [
  { title: 'Set up your environment', description: 'Build the CUDA 12.9 Docker environment and install the kernel, scheduler, and runtime.', href: '/guides/docker/', tag: 'START HERE' },
  { title: 'LLaDA2.0-mini', description: 'Start with a single GPU, paged attention, and block diffusion decoding.', href: '/guides/llada2-mini/', tag: '1 GPU' },
  { title: 'LLaDA2.0-flash', description: 'Configure tensor and expert parallelism for a four-GPU H100 deployment.', href: '/guides/llada2-flash/', tag: '4 GPUs' },
  { title: 'LLaDA2.1', description: 'Choose quality or speed presets with joint threshold decoding and token editing.', href: '/guides/llada2-1/', tag: 'DECODING PRESETS' },
];
---
<StarlightPage frontmatter={{ title: 'Deployment guides', description: 'Practical recipes for running FluxServe on NVIDIA GPUs, from Docker setup to multi-GPU serving.', template: 'splash', editUrl: false, lastUpdated: false }}>
  <div class="not-content section-intro"><p>From a clean environment to a running model.</p><p>Choose a recipe for your hardware and checkpoint. New to FluxServe? <a href="/docs/quickstart/">Start with the quickstart →</a></p></div>
  <div class="guide-grid not-content">
    {guides.map(guide => <a class="guide-card" href={guide.href}><span class="eyebrow">{guide.tag}</span><h2>{guide.title}<span aria-hidden="true">↗</span></h2><p>{guide.description}</p><span class="card-link">Read the guide →</span></a>)}
  </div>
</StarlightPage>
