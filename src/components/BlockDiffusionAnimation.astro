<figure class="block-diffusion" data-block-diffusion aria-label="Block diffusion and autoregressive generation comparison" aria-describedby="diffusion-caption">
  <div class="prompt-row"><span class="row-label">PROMPT</span><span class="prompt-text">Describe a fox crossing a river just before sunrise in one short sentence.</span><span class="step-count" data-step-count>Step 0 of 12</span></div>
  <div class="method-heading"><strong>Block diffusion</strong><span>Multiple positions decode in each pass</span></div>
  <div class="blocks" aria-label="Three generated blocks of four tokens each">
    {[0, 1, 2].map((blockIndex) => <div class="block" data-block={blockIndex} data-state={blockIndex === 0 ? 'active' : 'waiting'}>
      <div class="block-heading"><span>{['01 / FIRST BLOCK', '02 / SECOND BLOCK', '03 / THIRD BLOCK'][blockIndex]}</span><span class="block-state" data-block-state>{blockIndex === 0 ? 'Refining' : 'Waiting'}</span></div>
      <div class="tokens">{[0, 1, 2, 3].map(() => <span class="token" data-token data-masked="true">[MASK]</span>)}</div>
    </div>)}
  </div>
  <div class="ar-comparison">
    <div class="method-heading"><strong>Autoregressive generation</strong><span>One token decodes in each pass</span></div>
    <div class="ar-tokens" aria-label="Autoregressive output tokens">
      {Array.from({ length: 12 }, () => <span class="token ar-token" data-ar-token data-pending="true">·</span>)}
    </div>
  </div>
  <figcaption id="diffusion-caption">Illustrative comparison of decoding steps, not a timing benchmark. Undecoded diffusion positions remain [MASK]; dots mark future AR positions. &lt;eos&gt; marks the end of the sequence.</figcaption>
</figure>

<script>
  const diagram = document.querySelector<HTMLElement>('[data-block-diffusion]');
  if (diagram) {
    const output = ['A', 'fox', 'leaps', 'over', 'the', 'river', 'before', 'the', 'sun', 'rises', '.', '<eos>'];
    const revealOrder = [[2, 0, 3, 1], [1, 3, 0, 2], [2, 0, 1, 3]];
    const blocks = Array.from(diagram.querySelectorAll<HTMLElement>('[data-block]'));
    const arTokens = Array.from(diagram.querySelectorAll<HTMLElement>('[data-ar-token]'));
    const count = diagram.querySelector<HTMLElement>('[data-step-count]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = reducedMotion ? output.length : 0;
    let timer: number | undefined;
    let isVisible = false;
    const updateToken = (token: HTMLElement, value: string) => {
      if (token.textContent === value) return;
      token.textContent = value;
      token.classList.remove('changed');
      if (!reducedMotion) { void token.offsetWidth; token.classList.add('changed'); }
    };
    const render = () => {
      const decoded = Math.min(index * 2, output.length);
      count.textContent = `Step ${index} of ${output.length}`;
      blocks.forEach((block, blockIndex) => {
        const start = blockIndex * 4;
        const decodedInBlock = Math.max(0, Math.min(4, decoded - start));
        const state = decoded >= start + 4 ? 'complete' : decoded >= start ? 'active' : 'waiting';
        block.dataset.state = state;
        block.querySelector<HTMLElement>('[data-block-state]')!.textContent = state === 'complete' ? 'Complete' : state === 'active' ? 'Refining' : 'Waiting';
        block.querySelectorAll<HTMLElement>('[data-token]').forEach((token, tokenIndex) => {
          const position = start + tokenIndex;
          const masked = revealOrder[blockIndex].indexOf(tokenIndex) >= decodedInBlock;
          updateToken(token, masked ? '[MASK]' : output[position]);
          token.dataset.masked = String(masked);
        });
      });
      arTokens.forEach((token, position) => {
        const pending = position >= index;
        updateToken(token, pending ? '·' : output[position]);
        token.dataset.pending = String(pending);
      });
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    const advance = () => { index = (index + 1) % (output.length + 1); render(); };
    const start = () => {
      if (timer !== undefined || document.hidden) return;
      if (index === output.length) { index = 0; render(); }
      timer = window.setInterval(advance, 1250);
    };
    render();
    if (!reducedMotion) {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          isVisible = Boolean(entries[0]?.isIntersecting);
          if (isVisible) start(); else stop();
        }, { threshold: 0.1 });
        observer.observe(diagram);
      } else {
        isVisible = true;
        start();
      }
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop(); else if (isVisible) start();
      });
    }
  }
</script>

<style>
  .block-diffusion { max-width: 950px; margin: 1rem auto 1.25rem; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--sl-color-white); }
  .row-label, .block-heading, .step-count { font-family: var(--sl-font-mono); font-size: .68rem; letter-spacing: .08em; }
  .step-count { flex: none; color: var(--muted); }
  .prompt-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .75rem; padding: .7rem 1rem; border-bottom: 1px solid var(--line); }
  .row-label { color: var(--muted); }
  .prompt-text { padding: .3rem .55rem; border: 1px solid var(--line); border-radius: 6px; font-family: var(--sl-font-mono); font-size: .86rem; }
  .method-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: .75rem 1rem 0; }
  .method-heading strong { font-size: .88rem; }
  .method-heading span { color: var(--muted); font-size: .73rem; text-align: right; }
  .blocks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; padding: .5rem 1rem .75rem; }
  .block { min-width: 0; padding: .7rem; border: 1px solid var(--line); border-radius: 9px; transition: border-color .25s, background-color .25s; }
  .block[data-state='active'] { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 7%, transparent); }
  .block[data-state='complete'] { border-color: color-mix(in srgb, var(--brand) 60%, var(--line)); }
  .block-heading { display: flex; justify-content: space-between; gap: .5rem; margin-bottom: .55rem; color: var(--muted); }
  .block[data-state='active'] .block-state, .block[data-state='complete'] .block-state { color: var(--brand); }
  .tokens { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .4rem; }
  .token { display: flex; min-width: 0; min-height: 2.1rem; align-items: center; justify-content: center; padding: .2rem .1rem; overflow-wrap: anywhere; border: 1px solid var(--line); border-radius: 6px; background: var(--sl-color-bg); font-family: var(--sl-font-mono); font-size: clamp(.58rem, 1.4vw, .82rem); text-align: center; }
  .token[data-masked='true'], .ar-token[data-pending='true'] { color: var(--muted); border-style: dashed; }
  .token.changed { animation: token-change .42s ease-out; }
  .ar-comparison { border-top: 1px solid var(--line); }
  .ar-comparison .method-heading { padding-top: .75rem; }
  .ar-tokens { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: .4rem; padding: .5rem 1rem .75rem; }
  figcaption { padding: .5rem 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .73rem; line-height: 1.5; }
  @keyframes token-change { from { opacity: .35; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 780px) { .blocks { grid-template-columns: 1fr; } .ar-tokens { grid-template-columns: repeat(6, minmax(0, 1fr)); } .token { font-size: .8rem; } }
  @media (max-width: 640px) { .prompt-row { grid-template-columns: 1fr auto; gap: .5rem; } .prompt-text { grid-column: 1 / -1; grid-row: 2; } .method-heading { flex-direction: column; gap: .4rem; } .method-heading span { text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .block { transition: none; } .token.changed { animation: none; } }
</style>
