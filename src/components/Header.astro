---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';
const links = [
  { href: '/docs/getting_started/', label: 'Getting Started' },
  { href: '/docs/configuration/', label: 'Configuration' },
  { href: '/docs/model-recipes/', label: 'Model Recipes' },
  { href: '/blog/', label: 'Blog' },
];
---
<div class="flux-header">
  <a class="brand" href="/" aria-label="FluxServe home">
    <img src="/fluxserve/assets/logo.png" width="1942" height="296" alt="FluxServe" />
  </a>
  <div class="header-tools header-search"><Search /></div>
  <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="header-navigation"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
  <div id="header-navigation" class="header-navigation">
  <nav class="primary-nav" aria-label="Main navigation">
    {links.map(link => <a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <div class="header-tools">
    <ThemeToggle />
    <a class="github-link" href="https://github.com/FLX-OSS/FluxServe" aria-label="FluxServe on GitHub">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.55v-2.15c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.4-1.27.74-1.56-2.57-.29-5.28-1.29-5.28-5.75 0-1.27.46-2.31 1.19-3.12-.12-.29-.52-1.48.11-3.08 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.6.23 2.79.11 3.08.74.81 1.19 1.85 1.19 3.12 0 4.47-2.71 5.46-5.3 5.75.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.55A11.5 11.5 0 0 0 12 .7Z"/></svg>
    </a>
  </div>
  </div>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const header = document.querySelector<HTMLElement>('.flux-header');
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('nav-open');
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('nav-open', open);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !header?.contains(event.target)) closeMenu();
  });
  matchMedia('(max-width: 49.99rem)').addEventListener('change', closeMenu);
</script>
