---
import SpeedBenchmarkChart from './SpeedBenchmarkChart.astro';

// Illustrative placeholder data for the blog design. Replace with measured results.
const series = [
  { id: 'flux', name: 'FluxServe', values: [[40, 1510], [80, 1320], [120, 1110], [180, 850], [260, 610], [340, 430]] },
  { id: 'baseline', name: 'SGLang', values: [[40, 1320], [80, 1120], [120, 920], [180, 690], [260, 470], [340, 310]] },
] as const;
const xTicks = [0, 100, 200, 300, 400];
const yTicks = [0, 400, 800, 1200, 1600];
const x = (value: number) => 88 + value / 400 * 850;
const y = (value: number) => 370 - value / 1600 * 320;
---
<figure class="benchmark" aria-labelledby="plot-title" aria-describedby="benchmark-caption">
  <!-- <header class="benchmark-header">
    <div>
      <p class="eyebrow">SCALING PERFORMANCE</p>
      <h2 id="benchmark-title">Higher per-user demand trades off with output throughput</h2>
      <p>Illustrative performance profile for a single model. Lower input rate sustains higher output throughput.</p>
    </div>
  </header> -->

  <div class="legend" aria-label="Series legend">
    {series.map(item => <span><i class={item.id}></i>{item.name}</span>)}
  </div>

  <div class="chart-scroller" tabindex="0" aria-label="Scrollable scaling performance chart">
    <svg viewBox="0 0 1040 440" role="img" aria-labelledby="plot-title plot-description">
      <title id="plot-title">Single-model scaling performance</title>
      <desc id="plot-description">Placeholder data comparing FluxServe with a baseline. Both lines slope downward as user input tokens per second increase, while FluxServe maintains higher output tokens per second.</desc>

      <g class="chart-frame">
        {yTicks.map(tick => <g>
          <line x1="88" x2="938" y1={y(tick)} y2={y(tick)} />
          <text x="70" y={y(tick) + 5} text-anchor="end">{tick.toLocaleString('en-US')}</text>
        </g>)}
        {xTicks.map(tick => <g>
          <line x1={x(tick)} x2={x(tick)} y1="50" y2="370" />
          <text x={x(tick)} y="397" text-anchor="middle">{tick}</text>
        </g>)}
      </g>

      <text class="axis-label" x="513" y="430" text-anchor="middle">User/Input/Tok/S</text>
      <text class="axis-label" transform="translate(22 210) rotate(-90)" text-anchor="middle">Output/Tok/S</text>

      <defs>
        <clipPath id="plot-reveal"><rect class="reveal" x="82" y="44" width="864" height="334" /></clipPath>
      </defs>
      <g clip-path="url(#plot-reveal)">
        {series.map(item => <g class={`series ${item.id}`}>
          <polyline points={item.values.map(([input, output]) => `${x(input)},${y(output)}`).join(' ')} />
          {item.values.map(([input, output], index) => <circle style={`--point: ${index}`} cx={x(input)} cy={y(output)} r="5" />)}
        </g>)}
      </g>
    </svg>
  </div>

  <figcaption id="benchmark-caption">
    <span><b>Design preview:</b> values are placeholders intended to demonstrate the visualization and animation.</span>
    <a href="/docs/benchmark-guide/">Benchmark Guide ↗</a>
  </figcaption>
</figure>

<SpeedBenchmarkChart />

<style>
  .benchmark { min-width: 0; margin: 0; border: 1px solid var(--line); border-radius: 12px; background: var(--sl-color-bg); overflow: hidden; }
  .benchmark-header { padding: 1.5rem 1.6rem 1.35rem; border-bottom: 1px solid var(--line); }
  .eyebrow { margin: 0 0 .45rem; color: var(--brand); font: 650 .68rem var(--sl-font-mono); letter-spacing: .1em; }
  h2 { margin: 0; max-width: 38rem; color: var(--sl-color-white); font-size: clamp(1.25rem, 2.2vw, 1.65rem); line-height: 1.25; letter-spacing: -.025em; }
  .benchmark-header p:last-child { margin: .5rem 0 0; color: var(--muted); font-size: .82rem; }
  .legend { display: flex; justify-content: center; gap: 1.5rem; padding: .65rem 1.6rem 0; color: var(--muted); font-size: .9rem; }
  .legend span { display: flex; align-items: center; gap: .4rem; }
  .legend i { display: inline-block; width: 24px; border-top: 3px solid var(--brand); }
  .legend .baseline { border-color: #e9a136; border-top-style: dashed; }
  .chart-scroller { overflow-x: auto; overscroll-behavior-inline: contain; padding: 0 .85rem; }
  .chart-scroller:focus-visible { outline: 2px solid var(--brand); outline-offset: -3px; }
  svg { display: block; width: 100%; min-width: 700px; height: auto; }
  svg text { fill: var(--muted); font: 16px var(--sl-font-mono); }
  .chart-frame { animation: frame-in .45s ease-out both; }
  .chart-frame line { stroke: var(--line); stroke-width: 1; }
  .axis-label { fill: var(--sl-color-gray-2); font-size: 16px; font-weight: 600; }
  .series { stroke: var(--brand); fill: var(--brand); }
  .series.baseline { stroke: #f0a43a; fill: #cf780f; }
  .series polyline { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .series.baseline polyline { stroke-dasharray: 10 8; stroke-width: 2.75; }
  .series circle { stroke: var(--sl-color-bg); stroke-width: 2; opacity: 0; animation: point-in .3s ease-out calc(.55s + var(--point) * .12s) forwards; }
  .reveal { transform-box: fill-box; transform-origin: left center; animation: reveal 1.25s cubic-bezier(.22,.75,.25,1) .25s both; }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: .7rem 1.25rem; border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: .68rem; line-height: 1.45; }
  figcaption b { color: var(--sl-color-white); }
  figcaption a { flex-shrink: 0; color: var(--brand); }
  :global([data-theme='dark']) .series.flux { stroke: #ff6d91; fill: #ff6d91; }
  @keyframes frame-in { from { opacity: 0; } }
  @keyframes reveal { from { transform: scaleX(0); } }
  @keyframes point-in { from { opacity: 0; transform: scale(.5); transform-origin: center; } to { opacity: 1; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    .chart-frame, .reveal, .series circle { animation: none; opacity: 1; transform: none; }
  }
  @media (max-width: 42rem) {
    figcaption { align-items: start; flex-direction: column; gap: 1rem; }
  }
  @media (max-width: 25rem) { .benchmark-header, figcaption { padding-inline: .85rem; } }
</style>
